# clasp 的專案識別碼是每個組織自己的，不要進版本庫
.clasp.json
# 本機備份與雜物
舊版/
*.bak
node_modules/
.DS_Store
Thumbs.db
# PHP 版：各組織自己的設定與線上資料不進版本庫
php/ucc/lib/config.php
php/ucc/data/*
!php/ucc/data/.htaccess
!php/ucc/data/.gitignore

# 診斷頁管理金鑰（勿進版本庫）
php/ucc/lib/diag_key.php
php/diag_key.txt

# 快速登入金鑰（set_sso_keys.ps1 產生）
php/ucc/lib/sso_keys.php
